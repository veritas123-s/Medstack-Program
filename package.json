{
  "name": "ai-veritas",
  "productName": "Medstack",
  "version": "6.2.0",
  "private": true,
  "description": "医栈通 · 医栈事，一站通",
  "author": "Medtrix",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-cloud.mjs && node scripts/build-guides.mjs && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable",
    "format": "prettier --write src electron tests scripts docs *.json *.md *.html *.js",
    "format:check": "prettier --check src electron tests scripts docs *.json *.md *.html *.js",
    "scaffold:widget": "node scripts/scaffold-widget.mjs",
    "test:platform": "node scripts/platform-test.mjs",
    "test:assistant": "node scripts/assistant-test.mjs",
    "test:security": "node scripts/security-redteam.mjs",
    "dist:installer": "npm run build && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist",
    "dist:installer:ia32": "npm run build && node scripts/prepare-ia32.mjs && electron-builder --win nsis --ia32 --config.electronVersion=43.7.5 --config.electronDist=.cache/electron-43.7.5-ia32",
    "build:mobile-agent": "vite build --config vite.agent.config.js",
    "test:workhub": "node scripts/workhub-ui-test.mjs",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "test:interface": "node scripts/interface-ui-test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "ical.js": "2.2.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "local.ai.veritas",
    "productName": "Medstack",
    "directories": {
      "output": "release-medstack-6.2.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/domain.mjs",
      "docs/ORIGIN.md",
      "package.json",
      "assets/**/*",
      "src/briefing.mjs",
      "src/news-window.mjs",
      "src/news-preferences.mjs",
      "docs/licenses/SJTU-AGENT-MIT.txt",
      "src/domain/**/*.mjs",
      "src/platform/**/*.mjs",
      "src/themes/catalog.mjs",
      "src/assistant.mjs",
      "src/agenda.mjs",
      "src/themes/custom.mjs",
      "src/learning-policy.mjs",
      "src/calendar.mjs",
      "src/cloud-data.mjs",
      "src/agent/**/*.mjs",
      "src/releases.mjs"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "assets/icon.ico",
      "extraFiles": [
        {
          "from": "docs/licenses/SJTU-AGENT-MIT.txt",
          "to": "licenses/SJTU-AGENT-MIT.txt"
        },
        {
          "from": "docs/安装后使用说明.txt",
          "to": "使用说明.txt"
        },
        {
          "from": "docs/ORIGIN.md",
          "to": "来源说明.md"
        },
        {
          "from": "docs/TENCENT-CLI-LICENSE.txt",
          "to": "licenses/TENCENT-CLI-LICENSE.txt"
        },
        {
          "from": "docs/offline",
          "to": "帮助文档"
        },
        {
          "from": "docs/USER-GUIDE.md",
          "to": "帮助文档/USER-GUIDE.md"
        },
        {
          "from": "docs/DEVELOPER-HANDBOOK.md",
          "to": "帮助文档/DEVELOPER-HANDBOOK.md"
        }
      ]
    },
    "portable": {
      "artifactName": "Medstack-${version}-Windows-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "医栈通 Medstack",
      "artifactName": "Medstack-Setup-${version}-${arch}.${ext}",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "Medstack-${version}-macOS-${arch}.${ext}",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extraResources": [
        {
          "from": "docs/licenses/SJTU-AGENT-MIT.txt",
          "to": "licenses/SJTU-AGENT-MIT.txt"
        },
        {
          "from": "docs/安装后使用说明.txt",
          "to": "使用说明.txt"
        },
        {
          "from": "docs/ORIGIN.md",
          "to": "来源说明.md"
        },
        {
          "from": "docs/TENCENT-CLI-LICENSE.txt",
          "to": "licenses/TENCENT-CLI-LICENSE.txt"
        },
        {
          "from": "docs/offline",
          "to": "帮助文档"
        },
        {
          "from": "docs/USER-GUIDE.md",
          "to": "帮助文档/USER-GUIDE.md"
        },
        {
          "from": "docs/DEVELOPER-HANDBOOK.md",
          "to": "帮助文档/DEVELOPER-HANDBOOK.md"
        }
      ]
    },
    "dmg": {
      "title": "Medstack ${version}",
      "artifactName": "Medstack-${version}-macOS-${arch}.${ext}",
      "window": {
        "width": 560,
        "height": 360
      },
      "contents": [
        {
          "x": 160,
          "y": 170
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
